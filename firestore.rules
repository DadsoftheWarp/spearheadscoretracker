rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(groupId) {
      return request.auth != null &&
             request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // User personal game history — only the owner can read/write
    match /users/{userId}/games/{gameId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.inviteCode == resource.data.inviteCode
                    && (isMember(groupId) || request.auth.uid in
                    request.resource.data.members);
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /games/{gameId} {
        allow read, write: if isMember(groupId);
      }
    }

    // Anyone can submit a feature request, nobody can read them from the app
    match /feature_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
